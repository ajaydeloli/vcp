# Select the active adapter. Kite is implemented first; Dhan and Upstox are reserved.
DATA_PROVIDER=kite

# Kite Connect
KITE__API_KEY=
KITE__ACCESS_TOKEN=
KITE__API_SECRET=
KITE__MAX_HISTORICAL_DAYS=1900
KITE__REQUEST_DELAY_SECONDS=0.4
KITE__MAX_RETRIES=3

# Dhan (used after its adapter is added)
DHAN__CLIENT_ID=
DHAN__ACCESS_TOKEN=

# Upstox (used after its adapter is added)
UPSTOX__CLIENT_ID=
UPSTOX__CLIENT_SECRET=
UPSTOX__ACCESS_TOKEN=

# Scan scope. Nifty 500 is the default; full_nse and custom are also supported.
UNIVERSE_SCOPE=nifty500
NIFTY500_CONSTITUENTS_URL=https://www.niftyindices.com/IndexConstituent/ind_nifty500list.csv
# CUSTOM_UNIVERSE_PATH=config/custom_symbols.txt

# Fundamentals ingestion: Screener.in is the primary source of truth
# (decided 2026-09-27 -- NSE has no single destination that reliably
# returns the newest filings for a symbol). NSE/BSE exchange XBRL is kept
# available as an optional fallback/cross-check source.
FUNDAMENTALS__PRIMARY_SOURCE=screener
# FALLBACK_SOURCE=nse_xbrl means a symbol-quarter that fails to fetch/parse
# from the primary source falls back to the other source for that one
# symbol-quarter, always tagged source=<fallback>_fallback so it stays
# distinguishable from primary data. Default is "none" -- turn on
# deliberately.
FUNDAMENTALS__FALLBACK_SOURCE=none
# Independent sampled cross-check: compares stored primary-source values
# against the non-primary source for a rotating sample of symbol-quarters
# and reports disagreements. Never writes to fundamentals_quarterly.
FUNDAMENTALS__CROSS_CHECK_ENABLED=true
FUNDAMENTALS__CROSS_CHECK_SAMPLE_PCT=0.10

# Screener.in provider settings. announcement_date is estimated from
# period_end + a typical SEBI disclosure-window lag (Screener's quarterly
# page doesn't expose a real broadcast date) -- see ScreenerSettings in
# config/settings.py.
FUNDAMENTALS__SCREENER__BASE_URL=https://www.screener.in
FUNDAMENTALS__SCREENER__REQUEST_DELAY_SECONDS=1.0
FUNDAMENTALS__SCREENER__MAX_RETRIES=3
FUNDAMENTALS__SCREENER__ESTIMATED_QUARTERLY_ANNOUNCEMENT_LAG_DAYS=45
FUNDAMENTALS__SCREENER__ESTIMATED_ANNUAL_ANNOUNCEMENT_LAG_DAYS=60
