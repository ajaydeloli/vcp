# Select the active adapter. Kite is implemented first; Dhan and Upstox are reserved.
DATA_PROVIDER=kite

# Kite Connect
KITE__API_KEY=
KITE__ACCESS_TOKEN=
KITE__API_SECRET=
KITE__MAX_HISTORICAL_DAYS=1900
KITE__REQUEST_DELAY_SECONDS=0.4
KITE__MAX_RETRIES=3

# Dhan (used after its adapter is added)
DHAN__CLIENT_ID=
DHAN__ACCESS_TOKEN=

# Upstox (used after its adapter is added)
UPSTOX__CLIENT_ID=
UPSTOX__CLIENT_SECRET=
UPSTOX__ACCESS_TOKEN=

# Scan scope. Nifty 500 is the default; full_nse and custom are also supported.
UNIVERSE_SCOPE=nifty500
NIFTY500_CONSTITUENTS_URL=https://www.niftyindices.com/IndexConstituent/ind_nifty500list.csv
# CUSTOM_UNIVERSE_PATH=config/custom_symbols.txt
